{
  "listen": ":7001",
  "publicBind": "0.0.0.0",
  "publicHost": "tunnel.example.com",
  "portMin": 30000,
  "portMax": 39999,
  "certificate": "/etc/battly-tunnel/fullchain.pem",
  "key": "/etc/battly-tunnel/privkey.pem",
  "maxSessions": 512,
  "maxSessionsPerUser": 4,
  "maxConnectionsPerTunnel": 128,
  "maxTotalConnections": 2048,
  "maxHandshakes": 128,
  "heartbeatSeconds": 15,
  "leaseSeconds": 300,
  "idleSeconds": 300,
  "authUrl": "http://127.0.0.1:9081/authorize"
}
